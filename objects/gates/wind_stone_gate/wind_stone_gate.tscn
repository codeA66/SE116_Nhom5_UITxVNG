[sub_resource type="Shader" id="DustShader"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;
uniform sampler2D scene_depth : hint_depth_texture, repeat_disable, filter_nearest;

float noise_hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float soft_noise(vec2 p) {
    vec2 cell = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(noise_hash(cell), noise_hash(cell + vec2(1.0, 0.0)), f.x),
               mix(noise_hash(cell + vec2(0.0, 1.0)), noise_hash(cell + vec2(1.0, 1.0)), f.x), f.y);
}

void vertex() {
    // Billboard giữ nguyên kích thước từng hạt do hệ particle cấp.
    vec3 size = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
    MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0] * size.x,
        INV_VIEW_MATRIX[1] * size.y, INV_VIEW_MATRIX[2] * size.z, MODEL_MATRIX[3]);
}

void fragment() {
    vec2 p = UV - vec2(0.5);
    float grain = soft_noise(UV * 5.0 + vec2(2.3, 7.1));
    float cloud = 1.0 - smoothstep(0.12, 0.47, length(p) + (grain - 0.5) * 0.12);
    float depth = textureLod(scene_depth, SCREEN_UV, 0.0).r;
    // GL Compatibility dùng NDC z trong khoảng -1..1.
    vec4 behind = INV_PROJECTION_MATRIX * vec4(vec3(SCREEN_UV, depth) * 2.0 - 1.0, 1.0);
    float intersection_fade = smoothstep(0.0, 0.35, -behind.z / behind.w + VERTEX.z);
    ALBEDO = COLOR.rgb * mix(0.85, 1.0, grain);
    ALPHA = COLOR.a * cloud * mix(0.5, 0.9, grain) * intersection_fade;
}
"


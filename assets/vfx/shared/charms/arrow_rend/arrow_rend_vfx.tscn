[gd_scene format=3]

[ext_resource type="Script" path="res://assets/vfx/shared/charms/arrow_rend/arrow_rend_vfx.gd" id="1"]
[ext_resource type="Shader" path="res://assets/shaders/combat/death/combat_particle.gdshader" id="3"]

[sub_resource type="Shader" id="PullShader"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;

uniform vec4 violet : source_color = vec4(0.60, 0.30, 0.88, 1.0);
uniform vec4 silver : source_color = vec4(0.86, 0.91, 1.0, 1.0);
uniform float age : hint_range(0.0, 1.0) = 0.0;

void vertex() {
	vec3 center = MODEL_MATRIX[3].xyz;
	vec3 axis = MODEL_MATRIX[1].xyz;
	vec3 view = normalize(INV_VIEW_MATRIX[3].xyz - center);
	vec3 side = cross(normalize(axis), view);
	vec3 world = center + axis * VERTEX.y
		+ side / max(length(side), 0.0001) * VERTEX.x * length(MODEL_MATRIX[0].xyz);
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(world, 1.0);
}

void fragment() {
	float along = 1.0 - UV.y;
	float lateral = UV.x * 2.0 - 1.0;
	float shape = smoothstep(0.0, 0.34, along) * (1.0 - smoothstep(0.82, 1.0, along));
	float bend = 0.13 * sin(along * PI);
	float weave = abs(lateral + bend);
	float core = 1.0 - smoothstep(0.08, 0.28, weave);
	float fringe = 1.0 - smoothstep(0.22, 0.88, weave);
	float edge = (1.0 - smoothstep(0.035, 0.13, abs(lateral - 0.39 * shape))) * shape;
	float fade = 1.0 - smoothstep(0.46, 0.99, age);
	ALBEDO = mix(violet.rgb, silver.rgb, min(core + 0.62 * edge, 1.0));
	ALPHA = min(core * 0.94 + fringe * 0.49 + edge * 0.48, 1.0) * shape * fade;
}
"

[sub_resource type="ShaderMaterial" id="PullMaterial"]

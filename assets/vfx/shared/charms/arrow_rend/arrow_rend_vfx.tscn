[sub_resource type="Shader" id="ExtractFlashShader"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;

uniform vec4 rim_color : source_color = vec4(0.69, 0.39, 1.0, 1.0);
uniform vec4 silver : source_color = vec4(0.95, 0.96, 1.0, 1.0);
uniform float camera_bias : hint_range(0.0, 2.0) = 0.67;
uniform float age : hint_range(0.0, 1.0) = 0.0;

void vertex() {
	vec3 center = MODEL_MATRIX[3].xyz;
	vec3 view = normalize(INV_VIEW_MATRIX[3].xyz - center);
	float width = length(MODEL_MATRIX[0].xyz);
	float height = length(MODEL_MATRIX[1].xyz);
	vec3 world = center + view * camera_bias
		+ INV_VIEW_MATRIX[0].xyz * VERTEX.x * width + INV_VIEW_MATRIX[1].xyz * VERTEX.y * height;
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(world, 1.0);
}

void fragment() {
	vec2 p = (UV * 2.0 - 1.0) * vec2(1.0, 1.06);
	float r = length(p);
	float ramp = 1.0 - (1.0 - age) * (1.0 - age);
	float ring_radius = mix(0.21, 0.90, ramp);
	float d = abs(r - ring_radius);
	float angle = atan(p.y, p.x + 0.0001);
	float break_up = mix(1.0, smoothstep(-0.25, 0.62, cos(angle * 3.0 + 0.58)), ramp * 0.94);
	float ring_life = (1.0 - smoothstep(0.36, 0.98, age)) * break_up;
	float edge = (1.0 - smoothstep(0.012, 0.083, d)) * ring_life;
	float halo = (1.0 - smoothstep(0.065, 0.23, d)) * ring_life;
	float slash_axis = abs(dot(p, vec2(0.68, 0.73)));
	float spark_reach = abs(dot(p, vec2(0.73, -0.68)));
	float bevel = (1.0 - smoothstep(0.019, 0.085, slash_axis)) * (1.0 - smoothstep(0.17, 0.54, spark_reach));
	float snap = (1.0 - smoothstep(0.10, 0.47, age));
	float center = (1.0 - smoothstep(0.03, 0.32, r)) * snap;
	float bright = min(edge * (0.75 - 0.38 * age) + bevel * snap + center, 1.0);
	ALBEDO = mix(rim_color.rgb, silver.rgb, bright);
	ALPHA = min(edge * 0.89 + halo * 0.45 + bevel * snap * 0.81 + center * 0.66, 1.0)
		* (1.0 - smoothstep(0.88, 1.0, r));
}
"


[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/inventory/pages/settings/settings_page.gd" id="1_page"]
[ext_resource type="Theme" path="res://ui/theme/menu_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/menus/settings/settings_panel.tscn" id="3_panel"]
[ext_resource type="Resource" path="res://resources/ui/settings_panel_style_compact.tres" id="4_style"]

[node name="SettingsPage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_page")
page_title = "Cài Đặt"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="Heading" type="Label" parent="Layout"]
layout_mode = 2
text = "HỆ THỐNG / THIẾT LẬP"
horizontal_alignment = 1

[node name="Panel" parent="Layout" instance=ExtResource("3_panel")]
layout_mode = 2
size_flags_vertical = 3
panel_style = ExtResource("4_style")
show_description = false

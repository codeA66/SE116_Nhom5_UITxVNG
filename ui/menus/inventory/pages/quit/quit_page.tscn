[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/inventory/pages/quit/quit_page.gd" id="1_page"]
[ext_resource type="Theme" path="res://ui/theme/menu_theme.tres" id="2_theme"]

[node name="QuitPage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_page")
page_title = "Về Menu Chính"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Heading" type="Label" parent="Layout"]
layout_mode = 2
text = "HỆ THỐNG / THOÁT"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleButton" type="Button" parent="Layout/Buttons"]
custom_minimum_size = Vector2(340, 50)
layout_mode = 2
size_flags_horizontal = 4
text = "Về Màn Hình Chính"

[node name="DesktopButton" type="Button" parent="Layout/Buttons"]
custom_minimum_size = Vector2(340, 50)
layout_mode = 2
size_flags_horizontal = 4
text = "Thoát Khỏi Trò Chơi"

[node name="ConfirmBox" type="VBoxContainer" parent="Layout"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Layout/ConfirmBox"]
layout_mode = 2
text = "Lưu tiến trình và quay về Màn hình chính?"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Layout/ConfirmBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 20

[node name="Confirm" type="Button" parent="Layout/ConfirmBox/Buttons"]
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
text = "Xác nhận"

[node name="Cancel" type="Button" parent="Layout/ConfirmBox/Buttons"]
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
text = "Hủy"

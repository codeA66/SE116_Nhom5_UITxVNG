[resource]
script = ExtResource("1_blast")
input_action = &"skill"
state = &"WindBlast"
id = &"wind_blast"
display_name = "Thổi gió"
energy_cost = 1
icon = ExtResource("2_icon")
illustration = SubResource("AcquireIllustration")
accent_color = Color(0.65098, 0.87843, 0.93725, 1)
description = "Thổi một luồng gió về phía trước để tác động lên vật thể và kẻ địch."
acquire_verb = "Đã lĩnh hội"
acquire_prompt = "Nhấn {key} để thổi gió."

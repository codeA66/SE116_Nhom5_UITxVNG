[gd_resource type="Resource" script_class="CharmData" format=3]

[ext_resource type="Script" path="res://resources/player/items/_base/charm_data.gd" id="charm"]
[ext_resource type="Script" path="res://resources/player/items/effects/sword/sword_reflect_effect.gd" id="effect"]
[ext_resource type="Script" path="res://resources/player/items/_base/charm_effect.gd" id="base"]
[ext_resource type="Texture2D" path="res://assets/ui/charms/combat/hoi_phong_charm.png" id="icon"]

[sub_resource type="Resource" id="SwordReflect"]
script = ExtResource("effect")
push_speed = 12.0

[resource]
script = ExtResource("charm")
id = &"sword_reflect_charm"
display_name = "Bùa Hồi Phong"
icon = ExtResource("icon")
notch_cost = 1
description = "[buff]Chém trúng đạn[/buff] để hất ngược."
effects = Array[ExtResource("base")]([SubResource("SwordReflect")])

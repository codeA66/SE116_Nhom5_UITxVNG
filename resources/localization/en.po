msgid "Cài Đặt"
msgstr "Settings"

msgid "ĐANG ĐEO"
msgstr "EQUIPPED"

msgid "Chưa có bùa nào. Bùa nằm rải rác khắp đảo Foxy."
msgstr "No charms yet. They lie scattered across Foxy's island."

msgid "Đang ở khu đổi bùa: Enter để đeo / tháo."
msgstr "Press Enter to equip or remove a charm."

msgid "Chỉ đổi bùa được khi đứng ở khu đổi bùa."
msgstr "You can only change charms in a charm area."

msgid "Mục Đích"
msgstr "Purpose"

msgid "Enter: Chọn hành động"
msgstr "Enter: Select"

msgid "Lưu tiến trình nhân vật hiện tại và quay trở về màn hình chọn hồ sơ."
msgstr "Save your progress and return to the profile screen."

msgid "Lưu lại trò chơi và đóng hoàn toàn ứng dụng."
msgstr "Save your progress and close the game."

msgid "Ấn Gió"
msgstr "Wind Seal"

msgid "Ấn Lửa"
msgstr "Fire Seal"

msgid "Bùa Thử Thách"
msgstr "Trial Charm"

msgid "Chìa Khóa Gió"
msgstr "Wind Key"

msgid "Cung Gió"
msgstr "Wind Bow"

msgid "Cung Lửa"
msgstr "Fire Bow"

msgid "Cung"
msgstr "Bow"

msgid "Đá Năng Lượng"
msgstr "Energy Stone"

msgid "Giày Dung Nham"
msgstr "Lava Boots"

msgid "Gió"
msgstr "Wind"

msgid "Kiếm Gió"
msgstr "Wind Sword"

msgid "Kiếm Lửa"
msgstr "Fire Sword"

msgid "Kiếm"
msgstr "Sword"

msgid "Lốc xoáy"
msgstr "Wind Tornado"

msgid "Lửa"
msgstr "Fire"

msgid "Phun lửa"
msgstr "Flame Breath"

msgid "Thổi gió"
msgstr "Wind Blast"

msgid "Giờ có thể đi trên dung nham mà không mất máu."
msgstr "You can now cross lava unharmed."

msgid "Nhấn {key} để phun lửa."
msgstr "Press {key} to breathe fire."

msgid "Nhấn {key} để thổi gió."
msgstr "Press {key} to cast Wind Blast."

msgid "Đã lĩnh hội"
msgstr "Learned"

msgid "Đã nhận"
msgstr "Acquired"

msgid "Đã thức tỉnh"
msgstr "Awakened"

msgid "Ba nhát chém nối nhau. Ghép nguyên tố để mỗi nhát chém có thêm hiệu ứng."
msgstr "A chain of three slashes. Fuse an element to add effects to each strike."

msgid "Đế giày rèn từ đá núi lửa: đi trên dung nham không còn bị bỏng."
msgstr "Soles forged from volcanic stone let you walk across lava unharmed."

msgid "Giữ phím ngắm rồi bắn tên từ xa. Ghép nguyên tố để mũi tên có thêm hiệu ứng."
msgstr "Hold Aim to shoot from a distance. Fuse an element to empower your arrows."

msgid "Lắp vào bệ cạnh cổng xoáy ở phòng phụ để cổng hoạt động."
msgstr "Place it on the pedestal beside the portal in the side chamber to activate it."

msgid "Mở cổng dẫn tới Khu Gió ở khu trung tâm."
msgstr "Opens the gate to the Wind Region in the Central Temple."

msgid "Mọi nhát chém đánh bật được đạn của quái."
msgstr "Every slash can deflect enemy projectiles."

msgid "Mũi tên trúng đâu thì nở hố hút gió tại đó, hút quái quanh 2.5 m gom về một chỗ."
msgstr "Arrows create a vortex on impact, drawing in enemies within 2.5 m."

msgid "Nhát cuối của combo chém làm cháy mọi thứ dễ cháy trước mặt."
msgstr "The final slash ignites anything flammable in front of you."

msgid "Phần thưởng của Phòng Thử Thách Gió. (Bùa tạm: chưa có hiệu ứng.)"
msgstr "A reward from the Wind Trial. (Placeholder charm with no effect.)"

msgid "Phun lửa để đốt cháy mục tiêu trước mặt."
msgstr "Breathe fire to ignite targets in front of you."

msgid "Tên trúng đâu bùng lửa quanh đó khoảng 1 m, đốt cháy mọi thứ dễ cháy."
msgstr "Arrows flare on impact, igniting flammable objects within about 1 m."

msgid "Thả một cơn lốc chạy thẳng về phía trước, hút kẻ địch vào tâm rồi nổ tung hất chúng ra xa."
msgstr "Send a tornado forward. It pulls enemies in, then bursts and throws them back."

msgid "Thổi gió hóa thành cơn lốc chạy thẳng: hút kẻ địch vào tâm rồi nổ tung. Tốn 2 ô năng lượng."
msgstr "Wind Blast becomes a travelling tornado that pulls enemies in before bursting. Costs 2 Spirit."

msgid "Thổi một luồng gió về phía trước để tác động lên vật thể và kẻ địch."
msgstr "Send a gust forward to move objects and enemies."

msgid "Vật liệu nâng cấp kỹ năng Phun lửa. Mang tới người thợ ấn để nâng cấp."
msgstr "An upgrade material for Flame Breath. Bring it to the seal maker."

msgid "Vật liệu nâng cấp kỹ năng Thổi gió. Đủ số thì mở trang Nguyên tố để nâng cấp."
msgstr "An upgrade material for Wind Blast. Open Elements to upgrade when you have enough seals."

msgid "Chọn sử dụng trong túi đồ, rồi giữ T để nhắm (trong tầm 3 m), thả T để đặt khối thuốc nổ ở chỗ con trỏ. Khối chỉ nổ khi chạm lửa: phun lửa vào để kích nổ, gây sát thương cả vùng (đứng gần cũng bị nổ trúng)."
msgstr "Equip from the inventory. Hold T to aim within 3 m, then release to place the charge. Ignite it with Flame Breath and stand clear of the blast."

msgid "(Chữ tạm) Gió cuộn thành xoáy, kéo vật nhỏ về phía trước."
msgstr "(Placeholder) A swirling gust draws small objects forward."

msgid "(Chữ tạm) Lửa để lại vệt cháy trên mặt đất."
msgstr "(Placeholder) Fire leaves a burning trail."

msgid "(Chữ tạm) Luồng lửa dài hơn, cháy lâu hơn."
msgstr "(Placeholder) The flames reach farther and burn longer."

msgid "Khu Trung Tâm"
msgstr "Central Temple"

msgid "Khu Gió"
msgstr "Wind Region"

msgid "Khu Lửa"
msgstr "Fire Region"

msgid "Khu Băng"
msgstr "Ice Region"

msgid "Khu Sét"
msgstr "Thunder Region"

msgid "Bến Cảng Cung Điện"
msgstr "Palace Docks"

msgid "Sân Trong"
msgstr "Inner Courtyard"

msgid "Vườn Khỉ"
msgstr "Monkey Garden"

msgid "Quảng Trường Đền Thiêng"
msgstr "Sacred Temple Plaza"

msgid "Lối vào của gió"
msgstr "Gateway of the Winds"

msgid "Vùng đất hoang dã"
msgstr "The Wilds"

msgid "Núi Lửa Đỏ"
msgstr "Crimson Volcano"

msgid "Đỉnh Băng Giá"
msgstr "Frozen Peak"

msgid "Cung Điện Trên Mây"
msgstr "Palace in the Clouds"

msgid "Đảo Sấm Sét"
msgstr "Thunder Isle"

msgid "Bọ Đất"
msgstr "Burrow Beetle"

msgid "Kẻ Địch"
msgstr "Enemies"

msgid "Đạn đá bay tới thì nhấn {key} để thổi ngược lại."
msgstr "Press {key} as the stone approaches to blow it back."

msgid "Mai đá chặn mọi đòn. Chỉ viên đá của chính nó bị thổi ngược mới hạ được Bọ."
msgstr "Its stone shell blocks attacks. Reflect its own shot to defeat it."

msgid "Phản đạn"
msgstr "Reflect Projectiles"

msgid "Chờ Bọ nhả đạn đá, Thổi Gió đúng lúc để viên đá bay ngược vào nó."
msgstr "Wait for the beetle to fire, then time Wind Blast to send the stone back."

msgid "Đừng lại quá gần"
msgstr "Keep Your Distance"

msgid "Đứng sát quá Bọ sẽ chui xuống đất. Giữ khoảng cách để nó trồi lên bắn."
msgstr "Get too close and it burrows. Keep your distance so it surfaces and fires."

msgid "Hết gió?"
msgstr "Out of Spirit?"

msgid "Chém hình nộm trong sân để hồi năng lượng."
msgstr "Strike the training dummy in the arena to restore Spirit."

msgid "Cung Tên (Tầm Xa)"
msgstr "Bow (Ranged)"

msgid "Chiến Đấu"
msgstr "Combat"

msgid "Giữ {key1} để giương cung ngắm bắn, buông chuột để phóng tên."
msgstr "Hold {key1} to draw and aim your bow. Release to fire."

msgid "Vũ khí tầm xa luôn sẵn sàng bằng chuột phải, tiêu diệt kẻ thù từ xa và kích hoạt cơ chế bí mật."
msgstr "Use the right mouse button to strike foes from afar and trigger hidden mechanisms."

msgid "Ngắm bắn chuẩn xác"
msgstr "Aim Your Shot"

msgid "Giữ [RMB] để giương cung ngắm bắn, rê chuột đến mục tiêu và buông chuột để phóng tên."
msgstr "Hold [RMB] to draw the bow. Move the mouse to aim and release to fire."

msgid "Bắn cơ chế từ xa"
msgstr "Trigger Distant Mechanisms"

msgid "Mũi tên có thể kích hoạt các bia ngắm, công tắc hoặc đánh động kẻ địch ở những vị trí ngoài tầm đi bộ."
msgstr "Arrows can hit targets and switches or alert enemies beyond walking reach."

msgid "Lướt Nhanh (Dash)"
msgstr "Dash"

msgid "Kỹ Năng"
msgstr "Skills"

msgid "Nhấn {key} để lướt nhanh về phía trước."
msgstr "Press {key} to dash forward."

msgid "Lướt nhanh giúp phóng về phía trước tức thì, né tránh đòn đánh nguy hiểm hoặc vượt vực thẳm."
msgstr "Dash forward to evade attacks and cross gaps."

msgid "Lướt nhanh"
msgstr "Dash"

msgid "Nhấn [Shift] khi đang di chuyển để tăng tốc tức thì và lướt qua kẻ địch."
msgstr "Press [Shift] while moving to dash past enemies."

msgid "Né tránh nguy hiểm"
msgstr "Evade Danger"

msgid "Lướt nhanh để né các đòn tấn công nguy hiểm hoặc vượt qua các khe hẹp và cạm bẫy."
msgstr "Dash to evade dangerous attacks or cross narrow gaps and traps."

msgid "Vũ Khí & Chiến Đấu"
msgstr "Weapons & Combat"

msgid "Sử dụng vũ khí cận chiến hoặc tầm xa để tiêu diệt quái vật bảo vệ hòn đảo."
msgstr "Use melee and ranged weapons to defeat the island's guardians."

msgid "Tấn công cận chiến (Kiếm)"
msgstr "Melee Attack (Sword)"

msgid "Nhấn [Chuột Trái] để chém kiếm về phía mục tiêu. Đòn đánh có thể ngắt cử động của quái nhỏ."
msgstr "Press [LMB] to slash. A hit can interrupt small enemies."

msgid "Ngắm bắn tầm xa (Cung)"
msgstr "Ranged Aim (Bow)"

msgid "Nhấn [Chuột Phải] để giương cung, di chuột để ngắm và nhả ra để bắn tên gió."
msgstr "Hold [RMB] to draw the bow. Move the mouse to aim and release to fire a wind arrow."

msgid "Túi Đồ & Dung Hợp Nguyên Tố"
msgstr "Inventory & Element Fusion"

msgid "Nhấn {key1} để mở Túi Đồ & Dung Hợp. Nhấn {key2} để mở Sổ Hướng Dẫn."
msgstr "Press {key1} to open Inventory and Fusion. Press {key2} to open the Guidebook."

msgid "Nơi quản lý nguyên tố vừa thức tỉnh, dung hợp vào Kiếm/Cung để mở khóa đòn đánh đặc biệt và quản lý Bùa hộ mệnh."
msgstr "Manage awakened elements and charms. Fuse elements with your sword or bow to unlock special attacks."

msgid "Dung hợp nguyên tố"
msgstr "Element Fusion"

msgid "Trong tab Nguyên Tố, chọn nguyên tố đang sở hữu và gắn vào Kiếm hoặc Cung để truyền sức mạnh nguyên tố vào từng đòn đánh."
msgstr "In Elements, select an element you own and fuse it with your sword or bow to empower your attacks."

msgid "Đổi trang nhanh"
msgstr "Switch Pages"

msgid "Dùng phím [Z] và [C] để chuyển đổi giữa các trang Nguyên Tố, Túi Đồ, Bùa Hộ Mệnh và Sổ Hướng Dẫn."
msgstr "Use [Z] and [C] to switch between Elements, Items, Charms, and the Guidebook."

msgid "Phun Lửa (Flame Breath)"
msgstr "Flame Breath"

msgid "Nhấn {key} để phun lửa thiêu đốt."
msgstr "Press {key} to cast Flame Breath."

msgid "Ngọn lửa rực cháy thiêu đốt mục tiêu phía trước, thắp sáng đuốc cổ và phá hủy các vật cản bằng gỗ/mạng nhện."
msgstr "Burn enemies ahead, light ancient braziers, and clear wooden barriers or webs."

msgid "Thiêu đốt mục tiêu"
msgstr "Ignite Targets"

msgid "Phun luồng lửa nóng rực gây sát thương liên tục và thiêu đốt mọi kẻ thù đứng trước mặt."
msgstr "Breathe fire to deal sustained damage and ignite enemies in front of you."

msgid "Thắp sáng & Khai phá"
msgstr "Light the Way"

msgid "Ngọn lửa có thể thắp sáng các bệ đuốc cổ trong hầm tối và thiêu rụi các màng nhện hoặc chướng ngại vật dễ cháy."
msgstr "Light ancient braziers in dark cellars and burn away webs or flammable obstacles."

msgid "Kiếm Thép (Cận Chiến)"
msgstr "Steel Sword (Melee)"

msgid "Nhấn {key1} để chém kiếm liên hoàn."
msgstr "Press {key1} repeatedly to chain sword strikes."

msgid "Vũ khí cận chiến sắc bén, chém chuỗi combo 3 đòn bất kỳ lúc nào bằng chuột trái và có thể dung hợp nguyên tố."
msgstr "Use the left mouse button to chain three slashes. Fuse an element to empower them."

msgid "Đòn đánh combo 3 nhát"
msgstr "Three-Hit Combo"

msgid "Nhấn [LMB] liên tiếp để thực hiện chuỗi chém 3 đòn. Nhát chém cuối cùng có tầm quét rộng và lực đẩy lùi mạnh."
msgstr "Press [LMB] repeatedly for a three-hit combo. The final slash sweeps wide and knocks enemies back."

msgid "Tương tác môi trường"
msgstr "Use Your Surroundings"

msgid "Dùng kiếm chém để phát quang bụi cỏ, phá vỡ các chướng ngại vật mỏng manh hoặc phản lại đạn của quái."
msgstr "Use your sword to cut grass, break fragile obstacles, or deflect enemy projectiles."

msgid "Chào Mừng Đến Với Đảo Foxy"
msgstr "Welcome to Foxy's Island"

msgid "Cơ Bản"
msgstr "Basics"

msgid "Dùng {key1} {key2} {key3} {key4} để di chuyển. Nhấn {key5} để mở Sổ Hướng Dẫn."
msgstr "Move with {key1} {key2} {key3} {key4}. Press {key5} to open the Guidebook."

msgid "Di chuyển 8 hướng"
msgstr "Eight-Way Movement"

msgid "Sử dụng các phím [W, A, S, D] để điều khiển chú Cáo di chuyển linh hoạt theo 8 hướng trong thế giới."
msgstr "Use [W, A, S, D] to move Foxy in eight directions."

msgid "Khám phá thế giới"
msgstr "Explore the Island"

msgid "Đi qua các khu vực trên đảo Foxy để giải các câu đố cổ xưa và tìm kiếm những sức mạnh nguyên tố ẩn giấu."
msgstr "Explore Foxy's island to solve ancient puzzles and uncover hidden elemental powers."

msgid "Sổ Hướng Dẫn"
msgstr "Guidebook"

msgid "Nhấn phím [H] bất kỳ lúc nào để mở Sổ Hướng Dẫn tra cứu lại các cơ chế, kỹ năng và mẹo đã khám phá."
msgstr "Press [H] at any time to revisit discovered mechanics, skills, and tips in the Guidebook."

msgid "Thổi Gió (Wind Blast)"
msgstr "Wind Blast"

msgid "Nhấn {key} để phóng luồng gió mạnh."
msgstr "Press {key} to release a powerful gust."

msgid "Phóng luồng gió đẩy lùi kẻ địch, phản lại đạn đá và kích hoạt các cơ chế cối xay gió."
msgstr "Release a gust to push enemies, reflect stone shots, and activate windmills."

msgid "Đẩy lùi & Phản đạn"
msgstr "Push & Deflect"

msgid "Luồng gió có thể thổi bay kẻ địch nhỏ và phản lại các loại đạn bay (như hạt đá của quái Bọ) về phía kẻ thù."
msgstr "The gust can blow small enemies away and send projectiles, such as beetle stones, back at foes."

msgid "Kích hoạt cơ chế gió"
msgstr "Wind Mechanisms"

msgid "Thổi gió vào cối xay gió để hạ cầu, đẩy các tảng đá phong ấn hoặc dọn sạch đống đổ nát ngáng đường."
msgstr "Use Wind Blast to turn windmills and lower bridges, move seal stones, or clear debris."

msgid "Nhấn {key1} để thực hiện."
msgstr "Press {key1} to perform this action."

msgid "Nhấn %s để thực hiện."
msgstr "Press %s to perform this action."

msgid "[Space / Click] Tiếp tục   •   [H] Sổ Hướng Dẫn"
msgstr "[Space / Click] Continue   •   [H] Guidebook"

msgid "Dừng lại. Từng người một."
msgstr "Halt. One at a time."

msgid "Đừng đứng sau lưng ta. Muốn qua thì để ta nhìn thấy mặt."
msgstr "Do not stand behind me. If you wish to pass, let me see your face."

msgid "Ta vẫn giữ cửa. Cũng như người dưới kia vẫn giữ bến."
msgstr "I still keep the gate, just as the one below keeps the dock."

msgid "Người dưới bến kể cho ngươi nghe rồi?"
msgstr "The one at the dock told you already?"

msgid "Đêm ấy, tiếng gọi đã lên đến chân cầu. Ta nhận lệnh đóng cửa. Bên ngoài vẫn còn một ngọn đèn."
msgstr "That night, the call reached the foot of the bridge. I was ordered to shut the gate. A lantern still burned outside."

msgid "Đến sáng, có tiếng gõ. Ba tiếng, rất khẽ."
msgstr "At dawn came a knock. Three taps, barely audible."

msgid "Ta đã đặt tay lên then cửa… rồi mới nhận ra tiếng gõ ở phía sau mình."
msgstr "My hand was on the bolt… before I realized the knocking was behind me."

msgid "Ta vẫn nhớ mặt người cầm đèn."
msgstr "I still remember the face of the lantern bearer."

msgid "Chỉ có tên của người ấy… mỗi lần sắp nhớ ra, gió lại nổi lên."
msgstr "Only the name eludes me… Every time I nearly remember, the wind rises again."

msgid "Đứng gần đèn một chút, khách lạ. Ta muốn nhìn rõ mặt người sắp qua bến."
msgstr "Come closer to the lantern, stranger. Let me see who means to cross."

msgid "Ngày trước, bến này đông lắm. Đến tối, ta phải đếm đủ người mới cho chuyến cuối rời đi."
msgstr "This dock once thronged with people. Each evening I counted every passenger before the last crossing."

msgid "Có một đêm… ta đếm thiếu."
msgstr "One night… I came up short."

msgid "Đêm ấy, gió gọi tên từng người. Ai nghe thấy tên mình cũng đi về phía cung điện."
msgstr "That night, the wind called them by name. Each who heard their name walked toward the palace."

msgid "Chuyến thuyền cuối trở về lúc trời sáng. Không một người trên boong."
msgstr "The last ferry returned at dawn. No one was on deck."

msgid "Chỉ có chiếc đèn đặt ngay ngắn ở mũi thuyền. Lửa đã tắt… mà quai đèn vẫn còn ấm."
msgstr "Only a lantern stood neatly at the prow. Its flame was out… but the handle was still warm."

msgid "Ta từng nghĩ, cứ thắp đèn thì người lạc đường sẽ tìm được về."
msgstr "I once thought that if I kept the lantern lit, the lost would find their way home."

msgid "Bây giờ ta chỉ mong người trở về vẫn nhận ra ánh đèn này."
msgstr "Now I only hope those who return still recognize its light."

msgid "Gọi thuyền qua bến bên kia? Phí {price} {currency}."
msgstr "Call the ferry across? The fare is {price} {currency}."

msgid "Trả {price}"
msgstr "Pay {price}"

msgid "Thôi"
msgstr "Leave"

msgid "Cáo còn thiếu {missing} {currency}."
msgstr "You are short {missing} {currency}."

msgid "Thuyền đang tới. Chờ ở mép bến nhé."
msgstr "The ferry is coming. Wait by the dock."

msgid "Thuyền đã cập bến. Lên boong là đi được."
msgstr "The ferry is here. Step aboard when ready."

msgid "Thuyền đã rời bến rồi."
msgstr "The ferry has already left."

msgid "Bến tạm ngừng nhận khách."
msgstr "The dock is closed for now."


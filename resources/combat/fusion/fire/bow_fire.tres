[gd_resource type="Resource" script_class="FusionData" format=3]

[ext_resource type="Script" path="res://abilities/fusion/_base/fusion_data.gd" id="1_fusion"]
[ext_resource type="Resource" path="res://resources/combat/fusion/fire/fire.tres" id="2_fire"]
[ext_resource type="Script" path="res://abilities/fusion/_base/fusion_effect.gd" id="3_effect_base"]
[ext_resource type="Script" path="res://abilities/fusion/fire/effects/ignite_on_impact_effect.gd" id="4_impact"]
[ext_resource type="PackedScene" path="res://components/elements/fire/fire_touch/fire_touch.tscn" id="5_touch"]
[ext_resource type="PackedScene" path="res://assets/vfx/fire/fire_arrow/fire_arrow_trail.tscn" id="6_trail"]

[sub_resource type="Resource" id="IgniteImpact"]
script = ExtResource("4_impact")
touch_scene = ExtResource("5_touch")
flight_scene = ExtResource("6_trail")
warmup_scenes = Array[PackedScene]([ExtResource("5_touch"), ExtResource("6_trail")])

[resource]
script = ExtResource("1_fusion")
weapon_slot = 1
element = ExtResource("2_fire")
display_name = "Cung Lửa"
description = "Tên trúng đâu bùng lửa quanh đó khoảng 1 m, đốt cháy mọi thứ dễ cháy."
effects = Array[ExtResource("3_effect_base")]([SubResource("IgniteImpact")])

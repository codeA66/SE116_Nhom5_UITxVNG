[ext_resource type="Script" uid="uid://j74iydu2a0vu" path="res://resources/tutorials/tutorial_data.gd" id="1_tut"]

[resource]
script = ExtResource("1_tut")
id = &"movement"
title = "Chào Mừng Đến Với Đảo Foxy"
category = "Cơ Bản"
input_actions = Array[StringName]([&"move_forward", &"move_left", &"move_back", &"move_right", &"help"])
prompt_template = "{key1} {key2} {key3} {key4} Di chuyển"
sections = Array[Dictionary]([{
"heading": "Di chuyển 8 hướng",
"text": "Sử dụng các phím [W, A, S, D] để điều khiển chú Cáo di chuyển linh hoạt theo 8 hướng trong thế giới.",
"warning": false
}, {
"heading": "Khám phá thế giới",
"text": "Đi qua các khu vực trên đảo Foxy để giải các câu đố cổ xưa và tìm kiếm những sức mạnh nguyên tố ẩn giấu.",
"warning": false
}, {
"heading": "Sổ Hướng Dẫn",
"text": "Nhấn phím [H] bất kỳ lúc nào để mở Sổ Hướng Dẫn tra cứu lại các cơ chế, kỹ năng và mẹo đã khám phá.",
"warning": false
}])
lore = "Hòn đảo Foxy ẩn chứa vô vàn bí ẩn cùng những đền thờ cổ xưa đang chờ bạn khám phá."
order = 1
wait_for_action = true
completion_state = &"Run"

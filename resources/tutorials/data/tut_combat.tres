summary = "Sử dụng vũ khí cận chiến hoặc tầm xa để tiêu diệt quái vật bảo vệ hòn đảo."
sections = [{
"heading": "Tấn công cận chiến (Kiếm)",
"text": "Nhấn [Chuột Trái] để chém kiếm về phía mục tiêu. Đòn đánh có thể ngắt cử động của quái nhỏ.",
"warning": false
}, {
"heading": "Ngắm bắn tầm xa (Cung)",
"text": "Nhấn [Chuột Phải] để giương cung, di chuột để ngắm và nhả ra để bắn tên gió.",
"warning": false
}]
hint = "[Chuột Trái] Đánh  •  [Chuột Phải] Ngắm bắn  •  [H] Sổ Hướng Dẫn"

reflected_light_source = 2
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.055, 0.12, 0.15, 1)
fog_density = 0.002

[node name="WindFinalArena" type="Node3D"]
script = ExtResource("zone")
default_spawn_id = &"wind_final_entry"
shader_warmup = null

[node name="Lighting" type="Node3D" parent="."]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Lighting"]

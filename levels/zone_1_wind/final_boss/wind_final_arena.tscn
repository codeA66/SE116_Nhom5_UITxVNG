[node name="BossSpawn" type="Marker3D" parent="Anchors"]
position = Vector3(0, 0.03, -3)
rotation = Vector3(0, 3.141593, 0)

[node name="BossFight" parent="." instance=ExtResource("boss_fight")]
position = Vector3(0, 0.03, -3)
rotation = Vector3(0, 3.141593, 0)
boss_scene = ExtResource("ice_bear")
persistent_id = &"zone.wind.cleared"
trigger_size = Vector3(22, 4, 22)
start_delay = 0.5
visible_before_start = true

[node name="ReturnPortal" type="Node3D" parent="."]

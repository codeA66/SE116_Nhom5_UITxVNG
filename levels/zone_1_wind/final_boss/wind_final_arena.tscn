[node name="CloudBreak" type="DirectionalLight3D" parent="Lighting"]
rotation_degrees = Vector3(-58, -32, 0)
light_color = Color(0.73, 0.87, 1, 1)
light_energy = 1.25
shadow_enabled = true
directional_shadow_max_distance = 90.0

[node name="CloudFill" type="DirectionalLight3D" parent="Lighting"]
rotation_degrees = Vector3(-36, 145, 0)
light_color = Color(0.47, 0.58, 0.64, 1)
light_energy = 0.4

[node name="Architecture" type="Node3D" parent="."]

[node name="Stage" parent="Architecture" instance=ExtResource("stage")]

[node name="Shrine" parent="Architecture" instance=ExtResource("shrine")]

[node name="Weather" parent="Architecture" instance=ExtResource("weather")]

[node name="StormVault" parent="Architecture/Weather" index="0"]

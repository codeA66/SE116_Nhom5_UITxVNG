[ext_resource type="PackedScene" path="res://assets/models/map_wind/wind_palace_v1/final_sanctuary/geometry/weather/weather.gltf" id="weather"]

[ext_resource type="PackedScene" path="res://assets/vfx/wind/ambient/sanctuary/wind_sanctuary_ambience.tscn" id="ambience"]

[sub_resource type="Environment" id="WindSky"]
background_mode = 1
background_color = Color(0.025, 0.055, 0.073, 1)
ambient_light_source = 3
ambient_light_color = Color(0.56, 0.65, 0.72, 1)

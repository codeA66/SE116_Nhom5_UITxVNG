storm_vault = NodePath("../Architecture/Weather/StormVault")

[node name="Anchors" type="Node3D" parent="."]

[node name="Entry" type="Marker3D" parent="Anchors"]
position = Vector3(0, 0.08, 12.45)
script = ExtResource("spawn")

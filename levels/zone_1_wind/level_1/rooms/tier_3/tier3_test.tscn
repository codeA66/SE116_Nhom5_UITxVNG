[node name="TotemGuide" type="Node3D" parent="Rooms/EntryGarden/Decoration/TerritoryTotem3" unique_id=286058692]
script = ExtResource("7_j4dkc")
instructions = "Bạn đã thu thập được 1 trái chuối thần từ việc tiêu diệt hết khỉ trong phòng khởi đầu này.

Hãy đặt trái chuối đó lên bàn tế ở phòng trước mặt, rồi thu thập đủ 4 trái chuối thần còn lại từ 4 phòng xung quanh để gặp Vua Khỉ."

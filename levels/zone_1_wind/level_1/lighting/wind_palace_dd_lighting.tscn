[node name="WindPalaceDDLighting" type="Node3D"]
editor_description = "Ánh sáng thử hướng Death's Door: một tông xám xanh, nắng gần như rọi thẳng từ trên (mặt trên sáng, mặt đứng tối), không đèn điểm; màu nhấn chỉ là vật xanh ngọc / vật tự phát sáng. Phòng dùng prefab này KHÔNG cần trần chặn nắng."

[node name="Environment" type="WorldEnvironment" parent="."]

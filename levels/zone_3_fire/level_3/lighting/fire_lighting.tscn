[node name="FireLighting" type="Node3D"]
editor_description = "Ánh sáng map Lửa: nền đỏ tím tối, sương độ cao đỏ cam để chân nền đỡ tan vào hơi nóng. Nắng cam nhạt rọi gần thẳng xuống (mặt trên sáng, mặt đứng tối) giống zone 1; đèn hắt từ dưới lên giả ánh dung nham chiếu lên mặt đứng."

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("1_env")

[node name="SunLight" type="DirectionalLight3D" parent="."]
editor_description = "Rọi gần thẳng xuống, hơi xiên để tường đổ bóng vào góc. Bóng Orthogonal 1 lượt, tầm 60 m như zone 1."
transform = Transform3D(1, 0, 0, 0, 0.34202015, 0.9396926, 0, -0.9396926, 0.34202015, 0, 0, 0)
light_color = Color(1, 0.86, 0.74, 1)
light_energy = 0.9
shadow_enabled = true
directional_shadow_mode = 0
directional_shadow_max_distance = 60.0

[node name="LavaBounceLight" type="DirectionalLight3D" parent="."]
editor_description = "Đèn phụ không đổ bóng, chiếu từ dưới lên phía camera: giả ánh dung nham hắt lên mặt đứng của tường và nền đỡ, để chúng không đen kịt."
transform = Transform3D(0.5, 0, -0.8660254, 0.42261827, -0.8728144, 0.24400425, -0.7558978, -0.48799, -0.43642542, 0, 0, 0)
light_color = Color(1, 0.45, 0.18, 1)

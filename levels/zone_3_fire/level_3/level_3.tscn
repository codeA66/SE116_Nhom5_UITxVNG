[node name="FireLighting" type="Node3D" parent="." unique_id=135340820 instance=ExtResource("1_t5010")]
editor_description = "Ánh sáng map Lửa: nền đỏ tím tối, sương độ cao đỏ cam để chân nền đỡ tan vào hơi nóng. Nắng cam nhạt rọi gần thẳng xuống (mặt trên sáng, mặt đứng tối) giống zone 1; đèn hắt từ dưới lên giả ánh dung nham chiếu lên mặt đứng."


[sub_resource type="Shader" id="WindFlight"]
code = "shader_type particles;
render_mode disable_velocity;

uniform vec3 zone_half;
uniform float source_z;
uniform float flight_speed;
uniform vec2 flight_height;
uniform vec3 streak_half;
uniform vec3 panel_half;
uniform vec3 panel;
uniform vec3 paired_panel;
uniform vec3 fixed_center;
uniform vec3 fixed_half;
uniform bool has_panel;
uniform bool has_pair;
uniform bool has_fixed;
uniform float impact_time = 0.12;

float random_unit(uint seed) {
	seed = (seed ^ (seed >> 16u)) * 2246822519u;
	seed = (seed ^ (seed >> 13u)) * 3266489917u;
	return float(seed ^ (seed >> 16u)) / 4294967295.0;
}

void start() {
	uint seed = NUMBER + RANDOM_SEED;
	TRANSFORM = mat4(1.0);
	float across = mix(-zone_half.x, zone_half.x, random_unit(seed));
	float height = mix(flight_height.x, flight_height.y, random_unit(seed + 43u));
	TRANSFORM[3].xyz = vec3(across, height, source_z);
	CUSTOM = vec4(0.0);
	VELOCITY = vec3(0.0, 0.0, -flight_speed * mix(0.85, 1.0, random_unit(seed + 97u)));
	COLOR = vec4(0.79, 0.86, 1.0, 0.55);
}

float front_at(vec2 lane, vec3 center, vec3 half_size) {
	return all(lessThanEqual(abs(lane - center.xy), half_size.xy + streak_half.xy))
		? center.z + half_size.z : -1e20;
}

void process() {
	vec3 pos = TRANSFORM[3].xyz;
	if (CUSTOM.x > 0.0) {
		CUSTOM.x -= DELTA;
		COLOR.a = clamp(CUSTOM.x / impact_time, 0.0, 1.0);
		if (CUSTOM.x <= 0.0) { ACTIVE = false; }
	} else {
		float front = -1e20;
		if (has_panel) { front = front_at(pos.xy, panel, panel_half); }
		if (has_pair) { front = max(front, front_at(pos.xy, paired_panel, panel_half)); }
		if (has_fixed) { front = max(front, front_at(pos.xy, fixed_center, fixed_half)); }
		float next_z = pos.z + VELOCITY.z * DELTA;
		if (pos.z < front) {
			ACTIVE = false;
		} else if (next_z - streak_half.z <= front) {
			TRANSFORM[3].z = front + 0.08;
			TRANSFORM[0].x = 3.0;
			TRANSFORM[1].y = 2.0;
			TRANSFORM[2].z = 0.12;
			CUSTOM.x = impact_time;
			COLOR = vec4(0.75, 0.94, 1.0, 1.0);
		} else {
			TRANSFORM[3].z = next_z;
			if (next_z < -zone_half.z) { ACTIVE = false; }
		}
	}
}"


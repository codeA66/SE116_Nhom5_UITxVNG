[sub_resource type="Shader" id="PathShader"]
code = "shader_type spatial;
render_mode unshaded;
uniform float progress : hint_range(0.0, 1.0) = 0.0;
varying float distance_along;
void vertex() {
	distance_along = clamp(VERTEX.z / 10.15 + 0.5, 0.0, 1.0);
}
void fragment() {
	float front = smoothstep(0.0, 0.05, progress - distance_along);
	float lit = progress >= 1.0 ? 1.0 : front;
	ALBEDO = mix(vec3(0.21, 0.11, 0.065), vec3(2.8, 0.58, 0.07), lit);
}"


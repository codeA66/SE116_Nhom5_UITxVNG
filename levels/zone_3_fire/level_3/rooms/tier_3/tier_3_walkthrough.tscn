[node name="ZoneCameraView" type="Node" parent="."]
script = ExtResource("camera_zone")
view = SubResource("FireCamera")

[node name="StarterKit" type="Node" parent="."]
script = ExtResource("starter_kit")
weapons = Array[ExtResource("weapon_data")]([ExtResource("sword")])
abilities = Array[ExtResource("ability_data")]([ExtResource("dash")])
ability_levels = Dictionary[ExtResource("ability_data"), int]({
ExtResource("kit_wind"): 2
})
held_weapon = ExtResource("sword")

[node name="LiFoundry" parent="." instance=ExtResource("li")]
position = Vector3(0, 0, 44)

[node name="Tier3Walkthrough" type="Node3D"]
editor_description = "Sảnh bốn hướng. Chạm checkpoint ở lối vào phòng để lưu tiến trình."
script = ExtResource("zone")
shader_warmup = null

[node name="Walkthrough" type="Node" parent="."]
script = ExtResource("route")

[node name="FireLighting" parent="." instance=ExtResource("lighting")]

[node name="LavaSea" type="MeshInstance3D" parent="."]

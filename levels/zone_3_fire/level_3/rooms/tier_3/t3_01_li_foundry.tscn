[sub_resource type="Shader" id="FlameShader"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
uniform float charge : hint_range(0.0, 1.0) = 0.0;
varying float flame_height;
void vertex() {
	flame_height = clamp((VERTEX.y + 0.81) / 1.72, 0.0, 1.0);
}
void fragment() {
	vec3 ember = vec3(0.29, 0.07, 0.025);
	vec3 flame = mix(vec3(2.4, 0.45, 0.04), vec3(3.0, 1.95, 0.55), flame_height);
	ALBEDO = mix(ember, flame, charge);
}"


"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 0,
"values": [0.7, 2.5, 1.35, 0.7]
}

[sub_resource type="AnimationLibrary" id="SignalAnimations"]
_data = {&"LanternFlash": SubResource("LanternFlash")}

[node name="FerryAttendant" node_paths=PackedStringArray("animation_player") instance=ExtResource("1_npc")]

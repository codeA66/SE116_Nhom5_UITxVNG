[node name="HitFeedbackComponent" type="Node" parent="." node_paths=PackedStringArray("hurtbox", "squash_stretch")]
script = ExtResource("13_feedback")
hurtbox = NodePath("../HurtboxComponent")
squash_stretch = NodePath("../SquashStretch")
data = ExtResource("14_feedbackdata")

[node name="DeathEffectComponent" type="Node" parent="." node_paths=PackedStringArray("health", "model", "feedback")]
script = ExtResource("15_death")
health = NodePath("../HealthComponent")
model = NodePath("../Model")
feedback = NodePath("../HitFeedbackComponent")
data = ExtResource("16_deathdata")

[node name="EnemySpacing" type="Area3D" parent="."]
collision_layer = 0
collision_mask = 4
monitorable = false
script = ExtResource("17_spacing")

[node name="CollisionShape3D" type="CollisionShape3D" parent="EnemySpacing"]
position = Vector3(0, 0.8, 0)
shape = SubResource("SpacingShape")

[node name="BurnableComponent" parent="." node_paths=PackedStringArray("hurtbox", "match_shape_of", "wind_receiver", "fire_spread") instance=ExtResource("burn_comp")]

[ext_resource type="Script" uid="uid://b3ue3kprh711p" path="res://components/elements/wind/wind_receiver/wind_receiver_component.gd" id="4_wind"]
[ext_resource type="Script" uid="uid://bhy2r4v3q4hwg" path="res://components/feedback/squash_stretch/squash_stretch_component.gd" id="5_squash"]
[ext_resource type="PackedScene" path="res://components/utility/blob_shadow/blob_shadow.tscn" id="6_blob"]
